{
  "name": "Comment",
  "type": "object",
  "properties": {
    "bill_id": {
      "type": "string"
    },
    "office_id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "is_internal": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "bill_id",
    "text"
  ],
  "rls": {
    "create": {
      "data.office_id": "{{user.active_office_id}}"
    },
    "read": {
      "data.office_id": "{{user.active_office_id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}