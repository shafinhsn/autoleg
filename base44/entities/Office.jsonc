{
  "name": "Office",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Office name, e.g. Office of Assemblywoman Solages"
    },
    "creator_id": {
      "type": "string",
      "description": "ID of the user who created this office"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique invite code for employees to join"
    },
    "branding_color": {
      "type": "string",
      "default": "#1e3a5f",
      "description": "Primary branding color"
    },
    "senate_api_key": {
      "type": "string",
      "description": "NY Senate Open Legislation API key"
    }
  },
  "required": [
    "name",
    "creator_id",
    "invite_code"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "id": "{{user.active_office_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}