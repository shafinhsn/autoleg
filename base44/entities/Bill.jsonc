{
  "name": "Bill",
  "type": "object",
  "properties": {
    "office_id": {
      "type": "string",
      "description": "ID of the office this bill belongs to"
    },
    "priority_rank": {
      "type": "string",
      "description": "Priority rank e.g. 3/5, 5/5"
    },
    "bill_number": {
      "type": "string",
      "description": "Bill number e.g. A1234 or S5678"
    },
    "title": {
      "type": "string",
      "description": "Full title of the bill"
    },
    "short_name": {
      "type": "string",
      "description": "Short name or nickname"
    },
    "senate_sponsor": {
      "type": "string",
      "description": "Name of the senate sponsor"
    },
    "assembly_sponsor": {
      "type": "string",
      "description": "Name of the assembly sponsor"
    },
    "committee": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Committees the bill is assigned to (API-controlled)"
    },
    "status": {
      "type": "string",
      "description": "Legacy status field"
    },
    "current_procedural_status": {
      "type": "string",
      "description": "Where the bill currently sits procedurally \u2014 set by API sync only. Never contradicts milestones."
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Accumulated legislative milestones from API action history, e.g. ['Passed Assembly', 'Passed Senate']"
    },
    "status_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User-defined status annotations e.g. 'In Assembly Rules'. NEVER updated by API sync."
    },
    "pc_contact": {
      "type": "string",
      "description": "P&C Contact name"
    },
    "next_steps": {
      "type": "string",
      "description": "Next steps for the bill"
    },
    "session_comments": {
      "type": "string",
      "description": "Session comments"
    },
    "lobbyist": {
      "type": "string",
      "description": "Lobbyist or advocate"
    },
    "bill_documents": {
      "type": "string",
      "description": "Link to bill documents"
    },
    "internal_notes": {
      "type": "string",
      "description": "Internal notes"
    },
    "staff_assignees": {
      "type": "string",
      "description": "Staff assigned to this bill"
    },
    "linked_senate_bill": {
      "type": "string",
      "description": "Linked senate companion bill"
    },
    "google_drive_url": {
      "type": "string",
      "description": "Google Drive folder link"
    },
    "section_85": {
      "type": "string",
      "description": "Section 85 comments"
    },
    "is_caucus_bill": {
      "type": "boolean",
      "default": false
    },
    "chamber": {
      "type": "string",
      "enum": [
        "Assembly",
        "Senate"
      ],
      "default": "Assembly"
    },
    "session_year": {
      "type": "number",
      "default": 2026
    },
    "section_header": {
      "type": "string",
      "description": "Section group this bill belongs to (auto-synced with priority_rank)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Office-controlled priority/watchlist tags. NEVER updated by API sync."
    },
    "latest_status": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy field \u2014 kept for backwards compatibility"
    },
    "hearing_date": {
      "type": "string",
      "format": "date",
      "description": "Scheduled hearing or floor date"
    },
    "hearing_time": {
      "type": "string",
      "description": "Hearing time e.g. 10:00 AM"
    },
    "hearing_location": {
      "type": "string",
      "description": "Hearing room or location"
    }
  },
  "required": [
    "bill_number",
    "office_id"
  ],
  "rls": {
    "create": {
      "data.office_id": "{{user.active_office_id}}"
    },
    "read": {
      "data.office_id": "{{user.active_office_id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}