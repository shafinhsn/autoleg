{
  "name": "Membership",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user"
    },
    "office_id": {
      "type": "string",
      "description": "ID of the office"
    },
    "role": {
      "type": "string",
      "enum": [
        "OWNER",
        "ADMIN",
        "STAFF",
        "READ_ONLY"
      ],
      "default": "READ_ONLY",
      "description": "Role of the user within this office"
    },
    "invited_by": {
      "type": "string",
      "description": "ID of the user who invited this member"
    },
    "full_name": {
      "type": "string",
      "description": "Full name of the user (cached)"
    },
    "email": {
      "type": "string",
      "description": "Email of the user (cached)"
    }
  },
  "required": [
    "user_id",
    "office_id",
    "role"
  ]
}