{
  "name": "Task",
  "type": "object",
  "properties": {
    "office_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of assigned staff member"
    },
    "bill_id": {
      "type": "string",
      "description": "Related bill ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "doc_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uploaded document URLs"
    }
  },
  "required": [
    "title",
    "office_id"
  ],
  "rls": {
    "create": {
      "data.office_id": "{{user.active_office_id}}"
    },
    "read": {
      "data.office_id": "{{user.active_office_id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}